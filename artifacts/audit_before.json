    {
      "evidence": "pre-37725e1 scorer ranked candidate index 0 instead of ex.answer",
      "id": 1,
      "status": "CONFIRMED"
    },
    {
      "evidence": "50/50 latent eval files contain derived fields only and no raw candidate scores",
      "id": 2,
      "status": "CONFIRMED"
    },
    {
      "evidence": "13/13 2B best checkpoints were selected from histories produced by the legacy scorer; histories lack raw records",
      "id": 3,
      "status": "CONFIRMED"
    },
    {
      "evidence": "behavioral-v2 obj_track renders mutated final state as Initial situation",
      "id": 4,
      "status": "CONFIRMED"
    },
    {
      "evidence": "candidate counts vary from 2 through 100 and runtime ranks raw summed logprob; historical token lengths were not retained",
      "id": 5,
      "status": "PARTIALLY_CONFIRMED"
    },
    {
      "evidence": "latent_run/artifacts and corrected_scoring/no_spend accept incompatible raw fields and exact-tie policies",
      "id": 6,
      "status": "CONFIRMED"
    },
    {
      "evidence": "stored 4B direct/no-thinking is 97/112 ID and 84/112 OOD versus native-thinking 1/112 and 0/112; full generations are absent",
      "id": 7,
      "status": "CONFIRMED_WITH_NONRESCORABLE_CAVEAT"
    },
    {
      "evidence": "historical K runs trained separate adapters; same-adapter coverage omits K0 and LoRA affects prefill",
      "id": 8,
      "status": "CONFIRMED"
    },
    {
      "evidence": "full interval sends answer tokens after the first directly from embeddings to norm/lm_head without decoder layers",
      "id": 9,
      "status": "CONFIRMED"
    },
    {
      "evidence": "cache gradients detach while grad_checkpoint=true is persisted without an executed checkpointing path",
      "id": 10,
      "status": "CONFIRMED"
    },
    {
      "evidence": "VocabGuard misses tokenizer __call__, batch_decode, apply_chat_template, generate and alternate vocab paths",
      "id": 11,
      "status": "CONFIRMED"
    },
    {
      "evidence": "delimiter codec fails arbitrary delimiter keys, newlines, literal backslash-n and nested structures",
      "id": 12,
      "status": "CONFIRMED"
    },
    {
      "evidence": "numeric provenance accepts 142 from 1420 and 2 from 20.1 by substring matching",
      "id": 13,
      "status": "CONFIRMED"
    },
    {
      "evidence": "tampered persisted top-level run_id loads and compiles a foreign StoredRef",
      "id": 14,
      "status": "CONFIRMED"
    },
    {
      "evidence": "Python 3.11 compile fails and clean dev dependencies do not provide the lab test contract",
      "id": 15,
      "status": "CONFIRMED"
    },
    {
      "evidence": "built wheel contains latent_lab/bench; repository-root bench is a separate package not declared for installation",
      "id": 16,
      "status": "REFUTED"
    },
    {
      "evidence": "all 8 invalid 4B live runs are byte-identical to rejected copies; live reports are non-finite",
      "id": 17,
      "status": "CONFIRMED"
    },
